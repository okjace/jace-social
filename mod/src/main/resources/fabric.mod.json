{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Jace Social in Minecraft: friends, group chats and voice calls, host your world for friends (with e4mc or e4all) and join theirs in one click.",
  "authors": ["jace.deb"],
  "contact": {
    "homepage": "https://jace-store-deb.vercel.app/project/jace-social-minecraft",
    "sources": "https://github.com/okjace/jace-social/tree/main/mod",
    "issues": "https://github.com/okjace/jace-social/issues"
  },
  "license": "MIT",
  "icon": "assets/jacefriends/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.jacedeb.jacefriends.JaceFriendsFabric"]
  },
  "mixins": ["jacefriends.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader}",
    "minecraft": "${minecraft}",
    "fabric-api": "*"
  },
  "recommends": {
    "e4mc": "*"
  }
}
