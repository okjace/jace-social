# Supabase -> Project Settings -> API Keys
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "secret" (service role) key. SERVER ONLY - never expose it.
SUPABASE_SECRET_KEY=
# The "publishable" (anon) key. Safe to share: clients only use it to receive
# live notifications on their own private, unguessable channel.
SUPABASE_PUBLISHABLE_KEY=
# Optional: Cloudflare Realtime TURN relay for voice calls (Realtime -> TURN Server)
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# "Sign in with Jace" (register the app at Jace; redirect URI .../api/v1/auth/jace/callback)
JACE_OAUTH_CLIENT_ID=
JACE_OAUTH_CLIENT_SECRET=
# Syncing messages with Jace (lib/jaceSync.ts). A 32-byte key that encrypts people's Jace tokens:
#   openssl rand -base64 32      (keep it: changing it disconnects everyone's Jace messages)
JACE_TOKEN_KEY=
# Lets the scheduled sync call /api/v1/jace/cron (also the CRON_SECRET secret on GitHub)
CRON_SECRET=
# The official Jace bot's AI answers (lib/jaceBot.ts): Cloudflare Workers AI (free up to 10,000
# Neurons a day; Cloudflare doesn't train on it). Without them the bot answers with the best-matching Doc.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
# Optional: another Workers AI model (default @cf/meta/llama-3.1-8b-instruct-fp8-fast)
# JACE_AI_MODEL=
# Testing only: a local Jace instead of jaceo.vercel.app (node scripts/mock-jace.mjs). Never in production.
# JACE_URL=http://localhost:4000

# Optional: the Jace Official organization's Jace user id. Its thread (ban appeals) is never synced into
# normal chats (lib/jaceSync.ts); without this it's recognised by the name "Jace Official".
# JACE_OFFICIAL_USER_ID=

# Storage for uploads (lib/storage.ts): Cloudflare R2, then Backblaze B2, then Supabase - each used until
# it's nearly full (R2/B2 ~9.5 GB, Supabase ~0.95 GB; change with R2_LIMIT_GB, B2_LIMIT_GB,
# SUPABASE_STORAGE_LIMIT_GB). Leave R2/B2 out to use only Supabase. Their buckets need public read access
# and CORS allowing PUT from this site.
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=https://pub-xxxx.r2.dev          (the bucket's public URL)
# R2_ENDPOINT=                                    (optional: made from CLOUDFLARE_ACCOUNT_ID)
# B2_KEY_ID=
# B2_APPLICATION_KEY=
# B2_BUCKET=
# B2_ENDPOINT=s3.us-west-004.backblazeb2.com
# B2_PUBLIC_URL=https://f004.backblazeb2.com/file/<bucket>
